<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!-- Remove every source inherited from your PC (including Telerik) -->
    <clear />
    <!-- Then allow only the public NuGet feed -->
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>